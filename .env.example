# LOCAL DEVELOPMENT ONLY. Production must use APP_ENV=production and DEV_AUTH=false.
APP_ENV=development
DEV_AUTH=true
DATABASE_URL=sqlite:///./signalprep.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173
# Supabase Project Settings > API. Anon/publishable key is public; NEVER use service_role here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used by the frontend's server-side proxy. Never expose database/provider credentials in frontend variables.
BACKEND_URL=http://127.0.0.1:8000
# AI stays disabled until these are configured on the backend.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
